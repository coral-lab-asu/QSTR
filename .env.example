# Copy this file to .env and fill only the providers you use.
# Never commit .env or place credentials directly in scripts.
GEMINI_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=
DEEPINFRA_API_KEY=
HF_TOKEN=

# Optional provider and local-inference configuration.
OPENAI_BASE_URL=
DEEPINFRA_BASE_URL=https://api.deepinfra.com/v1/openai
HF_CACHE_ROOT=
CUDA_VISIBLE_DEVICES=0,1
TENSOR_PARALLEL_SIZE=2
GEMINI_MODEL=gemini-2.5-flash
